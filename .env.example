# Backend API URL
NEXT_PUBLIC_API_URL=https://your-ecommerce-api.onrender.com

# Frontend Site URL
NEXT_PUBLIC_FRONTEND_URL=https://yourstorefrontend.vercel.app

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=ShopIt Commerce